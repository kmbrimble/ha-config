                      state_attr('sensor.grid_energy_tariff_tracker_monthly_shoulder', 'last_period')|float(0) + 
                      state_attr('sensor.grid_energy_tariff_tracker_monthly_off_peak', 'last_period')|float(0) %}
          {{ ((1.3171 * days) + (mu * 0.3379)) | round(2) }}

      - name: "Previous Month Cost AGL TOU"

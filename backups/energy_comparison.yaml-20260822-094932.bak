      # ==========================================
      # DASHBOARD SUMMARY SENSORS (WINNERS)
      # ==========================================

      - name: "Winner Yesterday"
        unique_id: "winner_yesterday"
        icon: mdi:trophy-outline
        state: >
          {% set p_list = [
            {'n': 'AGL Flat', 'v': states('sensor.cost_agl_flat')|float(999)},
            {'n': 'AGL TOU', 'v': states('sensor.cost_agl_tou')|float(999)},
            {'n': 'AGL Dem', 'v': states('sensor.cost_agl_demand')|float(999)},
            {'n': 'Alinta Flat', 'v': states('sensor.cost_alinta_flat')|float(999)},
            {'n': 'Alinta TOU', 'v': states('sensor.cost_alinta_tou')|float(999)},
            {'n': 'Alinta Dem', 'v': states('sensor.cost_alinta_demand')|float(999)},
            {'n': 'GloBird Flat', 'v': states('sensor.cost_globird_flat')|float(999)},
            {'n': 'GloBird TOU', 'v': states('sensor.cost_globird_tou')|float(999)},
            {'n': 'GloBird Dem', 'v': states('sensor.cost_globird_demand')|float(999)},
            {'n': 'Kogan Flat', 'v': states('sensor.cost_kogan_flat')|float(999)},
            {'n': 'Kogan TOU', 'v': states('sensor.cost_kogan_tou')|float(999)},
            {'n': 'Kogan Dem', 'v': states('sensor.cost_kogan_demand')|float(999)},
            {'n': 'Lumo Flat', 'v': states('sensor.cost_lumo_flat')|float(999)},
            {'n': 'Lumo TOU', 'v': states('sensor.cost_lumo_tou')|float(999)},
            {'n': 'Lumo Dem', 'v': states('sensor.cost_lumo_demand')|float(999)},
            {'n': 'Origin Flat', 'v': states('sensor.cost_origin_flat')|float(999)},
            {'n': 'Origin TOU', 'v': states('sensor.cost_origin_tou')|float(999)},
            {'n': 'Origin Dem', 'v': states('sensor.cost_origin_demand')|float(999)},
            {'n': 'OVO Flat', 'v': states('sensor.cost_ovo_flat')|float(999)},
            {'n': 'OVO TOU', 'v': states('sensor.cost_ovo_tou')|float(999)},
            {'n': 'OVO Dem', 'v': states('sensor.cost_ovo_demand')|float(999)},
            {'n': 'Powershop Flat', 'v': states('sensor.cost_powershop_flat')|float(999)},
            {'n': 'Powershop TOU', 'v': states('sensor.cost_powershop_tou')|float(999)},
            {'n': 'Powershop Dem', 'v': states('sensor.cost_powershop_demand')|float(999)},
            {'n': 'Red Flat', 'v': states('sensor.cost_red_flat')|float(999)},
            {'n': 'Red TOU', 'v': states('sensor.cost_red_tou')|float(999)},
            {'n': 'Red Dem', 'v': states('sensor.cost_red_demand')|float(999)}
          ] %}
          {% set winner = p_list | selectattr('v', 'gt', 0) | sort(attribute='v') | first %}
          {{ winner.n if winner else 'Unknown' }} (${{ winner.v if winner else '0' }})

      - name: "Best Monthly Saving"
        unique_id: "best_monthly_saving"
        icon: mdi:piggy-bank-outline
        state: >
          {% set baseline = states('sensor.monthly_cost_alinta_flat') | float(0) %}
          {% set p_list = [
            {'n': 'AGL Flat', 'v': states('sensor.monthly_cost_agl_flat')|float(999)},
            {'n': 'AGL TOU', 'v': states('sensor.monthly_cost_agl_tou')|float(999)},
            {'n': 'AGL Dem', 'v': states('sensor.monthly_cost_agl_demand')|float(999)},
            {'n': 'Alinta TOU', 'v': states('sensor.monthly_cost_alinta_tou')|float(999)},
            {'n': 'Alinta Dem', 'v': states('sensor.monthly_cost_alinta_demand')|float(999)},
            {'n': 'GloBird Flat', 'v': states('sensor.monthly_cost_globird_flat')|float(999)},
            {'n': 'GloBird TOU', 'v': states('sensor.monthly_cost_globird_tou')|float(999)},
            {'n': 'GloBird Dem', 'v': states('sensor.monthly_cost_globird_demand')|float(999)},
            {'n': 'Kogan Flat', 'v': states('sensor.monthly_cost_kogan_flat')|float(999)},
            {'n': 'Kogan TOU', 'v': states('sensor.monthly_cost_kogan_tou')|float(999)},
            {'n': 'Kogan Dem', 'v': states('sensor.monthly_cost_kogan_demand')|float(999)},
            {'n': 'Lumo Flat', 'v': states('sensor.monthly_cost_lumo_flat')|float(999)},
            {'n': 'Lumo TOU', 'v': states('sensor.monthly_cost_lumo_tou')|float(999)},
            {'n': 'Lumo Dem', 'v': states('sensor.monthly_cost_lumo_demand')|float(999)},
            {'n': 'Origin Flat', 'v': states('sensor.monthly_cost_origin_flat')|float(999)},
            {'n': 'Origin TOU', 'v': states('sensor.monthly_cost_origin_tou')|float(999)},
            {'n': 'Origin Dem', 'v': states('sensor.monthly_cost_origin_demand')|float(999)},
            {'n': 'OVO Flat', 'v': states('sensor.monthly_cost_ovo_flat')|float(999)},
            {'n': 'OVO TOU', 'v': states('sensor.monthly_cost_ovo_tou')|float(999)},
            {'n': 'OVO Dem', 'v': states('sensor.monthly_cost_ovo_demand')|float(999)},
            {'n': 'Powershop Flat', 'v': states('sensor.monthly_cost_powershop_flat')|float(999)},
            {'n': 'Powershop TOU', 'v': states('sensor.monthly_cost_powershop_tou')|float(999)},
            {'n': 'Powershop Dem', 'v': states('sensor.monthly_cost_powershop_demand')|float(999)},
            {'n': 'Red Flat', 'v': states('sensor.monthly_cost_red_flat')|float(999)},
            {'n': 'Red TOU', 'v': states('sensor.monthly_cost_red_tou')|float(999)},
            {'n': 'Red Dem', 'v': states('sensor.monthly_cost_red_demand')|float(999)}
          ] %}
          {% set best = p_list | selectattr('v', 'gt', 0) | sort(attribute='v') | first %}
          {% if best and baseline > 0 %}
            {% set savings = (baseline - best.v) | round(2) %}
            {{ best.n }} (${{ savings }})
          {% else %}
            Calculating...
          {% endif %}

# ==========================================
  # PREVIOUS MONTH SENSORS (Historical Data)
  # ==========================================

      # 1. Helper: Days in previous month (for accurate supply charge)
      - name: "Days in Previous Month"
        unique_id: "days_in_previous_month_calc"
        state: "{{ (now().replace(day=1) - timedelta(days=1)).day }}"

      # 2. Previous Month Costs (Using 'last_period' attributes)
      
      # --- ALINTA ---
      - name: "Previous Month Cost Alinta Flat"
        unique_id: "prev_month_cost_alinta_flat"
        unit_of_measurement: "$"
        state: >
          {% set days = states('sensor.days_in_previous_month')|int(30) %}
          {% set mu = state_attr('sensor.grid_energy_tariff_tracker_monthly_peak', 'last_period')|float(0) + 
                      state_attr('sensor.grid_energy_tariff_tracker_monthly_shoulder', 'last_period')|float(0) + 
                      state_attr('sensor.grid_energy_tariff_tracker_monthly_off_peak', 'last_period')|float(0) %}
          {{ ((1.5585 * days) + (mu * 0.3421)) | round(2) }}

      - name: "Previous Month Cost Alinta TOU"
        unique_id: "prev_month_cost_alinta_tou"
        unit_of_measurement: "$"
        state: >
          {% set days = states('sensor.days_in_previous_month')|int(30) %}
          {% set mp = state_attr('sensor.grid_energy_tariff_tracker_monthly_peak', 'last_period')|float(0) %}
          {% set ms = state_attr('sensor.grid_energy_tariff_tracker_monthly_shoulder', 'last_period')|float(0) %}
          {% set mo = state_attr('sensor.grid_energy_tariff_tracker_monthly_off_peak', 'last_period')|float(0) %}
          {{ ((1.2935 * days) + (mp*0.4293 + ms*0.3106 + mo*0.1795)) | round(2) }}

      # --- AGL ---
      - name: "Previous Month Cost AGL Flat"
        unique_id: "prev_month_cost_agl_flat"

          {% set ms = state_attr('sensor.grid_energy_tariff_tracker_monthly_shoulder', 'last_period')|float(0) %}
          {% set mo = state_attr('sensor.grid_energy_tariff_tracker_monthly_off_peak', 'last_period')|float(0) %}
          {{ ((1.31 * days) + (mp*0.4950 + ms*0.4510 + mo*0.3465)) | round(2) }}

      # --- RED ENERGY ---
      - name: "Previous Month Cost Red Flat"
        unique_id: "prev_month_cost_red_flat"
        unit_of_measurement: "$"
        state: >
          {% set days = states('sensor.days_in_previous_month')|int(30) %}
          {% set mu = state_attr('sensor.grid_energy_tariff_tracker_monthly_peak', 'last_period')|float(0) + 
                      state_attr('sensor.grid_energy_tariff_tracker_monthly_shoulder', 'last_period')|float(0) + 
                      state_attr('sensor.grid_energy_tariff_tracker_monthly_off_peak', 'last_period')|float(0) %}
          {{ ((1.33 * days) + (mu * 0.34)) | round(2) }}

      - name: "Previous Month Cost Red TOU"
        unique_id: "prev_month_cost_red_tou"
        unit_of_measurement: "$"
        state: >
          {% set days = states('sensor.days_in_previous_month')|int(30) %}
          {% set mp = state_attr('sensor.grid_energy_tariff_tracker_monthly_peak', 'last_period')|float(0) %}
          {% set ms = state_attr('sensor.grid_energy_tariff_tracker_monthly_shoulder', 'last_period')|float(0) %}
          {% set mo = state_attr('sensor.grid_energy_tariff_tracker_monthly_off_peak', 'last_period')|float(0) %}
          {{ ((1.1920 * days) + (mp*0.4435 + ms*0.3210 + mo*0.2055)) | round(2) }}


utility_meter:
  grid_energy_tariff_tracker:
    unique_id: "grid_energy_tariff_tracker_select"
    name: "Grid Energy Tariff Tracker"
    # UPDATED: Points to the accumulator
    source: sensor.total_grid_energy
    cycle: daily
    tariffs:
      - peak
      - shoulder
      - off_peak

  grid_energy_tariff_tracker_monthly:
    unique_id: "grid_energy_tariff_tracker_monthly_meter"
    name: "Monthly Grid Energy Tracker"
    # UPDATED: Points to the accumulator
    source: sensor.total_grid_energy
    cycle: monthly
    tariffs:
      - peak
      - shoulder
      - off_peak

automation:
  - alias: "Energy Tariff Switcher"
    id: "energy_tariff_switcher_auto"
    initial_state: true
    trigger:
      - platform: time
        at: ["11:00:00", "16:00:00", "21:00:00"]
      - platform: homeassistant
        event: start
    action:
      # 1. Determine the current tariff based on Time of Day
      - variables:
          current_tariff: >
            {% set h = now().hour %}
            {% if 11 <= h < 16 %} off_peak
            {% elif 16 <= h < 21 %} peak
            {% else %} shoulder
            {% endif %}
      
      # 2. Apply to Daily Tracker
      - service: select.select_option
        target:
          entity_id: select.grid_energy_tariff_tracker
        data:
          option: "{{ current_tariff }}"
          
      # 3. Apply to Monthly Tracker
      - service: select.select_option
        target:
          entity_id: select.grid_energy_tariff_tracker_monthly
        data:
          option: "{{ current_tariff }}"
- id: '1753261424213'
  alias: Motion - Side Yard
  description: ''
  triggers:
  - entity_id:
    - binary_sensor.cameras_side_yard_motion
    from: 'off'
    to: 'on'
    trigger: state
  conditions:
  - condition: sun
    before: sunrise
    after: sunset
  - condition: device
    type: is_off
    device_id: ac4bd6d7610348b9940d14d6495d5179
    entity_id: ee6258d308aedf7b45caea34984788b0
    domain: light
  actions:
  - alias: Turn on the light
    action: light.turn_on
    data:
      brightness_pct: 100
    target:
      entity_id:
      - light.bedroom_3
  - alias: Wait until there is no motion from device
    wait_for_trigger:
      entity_id: binary_sensor.cameras_top_yard_motion
      from: 'on'
      to: 'off'
      trigger: state
    timeout:
      hours: 0
      minutes: 1
      seconds: 0
      milliseconds: 0
  - alias: Wait the number of seconds that has been set
    delay:
      hours: 0
      minutes: 5
      seconds: 0
      milliseconds: 0
  - alias: Turn off the light
    action: light.turn_off
    data: {}
    target:
      entity_id:
      - light.bedroom_3
  - delay:
      hours: 0
      minutes: 0
      seconds: 5
      milliseconds: 0
  - alias: Turn off the light
    action: light.turn_off
    data: {}
    target:
      entity_id:
      - light.bedroom_3
  mode: single
  max_exceeded: silent

- id: '1787989550000'
  alias: Internal Door Lock Battery Low
  description: ''
  triggers:
  - trigger: numeric_state
    entity_id: sensor.internal_door_battery
    below: 20
  conditions: []
  actions:
  - action: notify.mobile_app_kierens_iphone_17
    metadata: {}
    data:
      title: Door lock battery low
      message: 'Internal Door lock battery is below 20% ({{ states("sensor.internal_door_battery") }}%). Recharge soon.'
  mode: single
- id: '1787989686000'
  alias: Blind Battery Low
  description: ''
  triggers:
  - trigger: numeric_state
    entity_id:
    - sensor.rollerblind_0001_battery
    - sensor.rollerblind_0002_battery
    - sensor.rollerblind_0003_battery
    - sensor.rollerblind_0004_battery
    - sensor.upstairs_1_battery
    - sensor.rollerblind_0006_battery
    - sensor.rollerblind_0007_battery
    - sensor.rollerblind_0008_battery
    below: 30
  conditions: []
  actions:
  - action: notify.mobile_app_kierens_iphone_17
    metadata: {}
    data:
      title: Blind battery low
      message: '{{ trigger.to_state.attributes.friendly_name }} is below 30% ({{ trigger.to_state.state }}%). Recharge soon.'
  mode: queued
- id: arrive_home_front_footpath_lights
  alias: Arrive Home - Front and Footpath Lights
  description: On arrival after dark, front + footpath lights to 100% for 15 min, then off (twice, Tuya misses). Footpath left alone if the daily automation already had it on.
  triggers:
  - trigger: state
    entity_id:
    - person.kieren
    - person.t
    from: not_home
    to: home
  conditions:
  - condition: sun
    after: sunset
    before: sunrise
  actions:
  - variables:
      footpath_was_on: '{{ is_state(''switch.pc191ha_series_3_8_socket_1'', ''on'') }}'
  - action: light.turn_on
    data:
      brightness_pct: 100
    target:
      entity_id: light.house_front
  - action: switch.turn_on
    target:
      entity_id: switch.pc191ha_series_3_8_socket_1
  - delay:
      minutes: 15
  - action: light.turn_off
    target:
      entity_id: light.house_front
  - if:
    - condition: template
      value_template: '{{ not footpath_was_on }}'
    then:
    - action: switch.turn_off
      target:
        entity_id: switch.pc191ha_series_3_8_socket_1
  - delay:
      minutes: 1
  - action: light.turn_off
    target:
      entity_id: light.house_front
  - if:
    - condition: template
      value_template: '{{ not footpath_was_on }}'
    then:
    - action: switch.turn_off
      target:
        entity_id: switch.pc191ha_series_3_8_socket_1
  mode: single
